# SplusLib
FBI_PHONE=+989117904799
FBI_2FA_PASSWORD=
FBI_SESSION=sessions/fbi_splus

# SUDO / سازنده — شناسه عددی حساب‌های سازنده را comma-separated بگذارید
FBI_SUDOS=56597421,69871358

# سازنده‌ها: شناسه‌های پیش‌فرض بالا را با شناسه‌های واقعی حساب‌های سازندهٔ خودتان تنظیم کنید.

# Hugging Face
FBI_HF_TOKEN=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
# یا می‌توانید از HF_TOKEN استفاده کنید: HF_TOKEN=hf_xxxxxxxxxxxxxxxxx
FBI_HF_MODEL=openai/gpt-oss-120b:fastest
# FBI_HF_PROVIDER=groq  # اختیاری؛ در حالت خالی، :fastest توسط HF انتخاب می‌شود
FBI_HF_MAX_TOKENS=350
FBI_HF_TEMPERATURE=0.85
FBI_HF_MEMORY_MESSAGES=8

# ذخیره داده
FBI_DB_BACKEND=json
# FBI_DB_BACKEND=sqlite

# پنل وب گروه‌ها و پنل سازنده /owner
FBI_WEB_PANEL_ENABLED=1
# روی تمام رابط‌های شبکه گوش می‌دهد (برای LAN و سرور)
FBI_WEB_PANEL_HOST=0.0.0.0
FBI_WEB_PANEL_PORT=8080
# برای لینک واقعی اینترنت، دامنه عمومی HTTPS یا URL تونل را وارد کنید؛ نمونه: https://panel.example.com
# اگر خالی باشد، IP شبکه محلی به‌صورت خودکار انتخاب می‌شود (فقط همان Wi-Fi/LAN).
FBI_WEB_PANEL_BASE_URL=mehrbanoopashak.ir
# اگر cloudflared نصب باشد، در شروع ربات لینک عمومی موقت را خودکار ایجاد می‌کند.
# روی Windows: winget install -e --id Cloudflare.cloudflared
# لینک trycloudflare موقت است و بعد از راه‌اندازی مجدد ممکن است تغییر کند.
FBI_WEB_PANEL_TUNNEL=1
FBI_WEB_PANEL_TOKEN_TTL_HOURS=168
FBI_WEB_PANEL_CREATOR_TOKEN_TTL_HOURS=24

# وقتی تونل عمومی روشن است و cloudflared نصب نیست، فایل رسمی را از GitHub می‌گیرد و SHA-256 را بررسی می‌کند.
FBI_WEB_PANEL_AUTO_INSTALL_CLOUDFLARED=1